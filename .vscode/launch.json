  "version": "0.2.0",
  "configurations": [
    {
      "name": "tap-s3-csv",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "tap_s3_csv",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "justMyCode": false,
      "args": [
        "--config",
        ".secrets/config.json",
        "--state",
        ".secrets/state.json",
        ">",
        "output/output.jsonl"
      ]
    }
  ]
}
